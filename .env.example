# Projet Supabase partagé avec l'application mobile Runly.
# Dashboard Supabase → Project Settings → API
#
# Copier ce fichier en .env.local pour le développement, et reporter les deux
# variables dans les réglages du déploiement (Vercel → Environment Variables).
#
# N'ajoute JAMAIS la clé service_role ici : elle contourne toute la RLS et
# serait embarquée dans le bundle envoyé au navigateur.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
